# Frontend Supabase Config
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend Supabase Config
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Other configs
HEADLESS=true

# Admin login gatekeeper (system access token) — required ALONGSIDE a valid
# admin email + password on the admin login screen. SERVER-ONLY: it must never
# be a NEXT_PUBLIC_ value (the old NEXT_PUBLIC_ADMIN_GATEKEEPER shipped to every
# browser and doubled as a full admin backdoor). There is no hardcoded fallback.
# The live token is normally configured in system_settings.security_auth; this
# env var is the bootstrap fallback for the first admin login. Set a long,
# random value in production.
ADMIN_GATEKEEPER=your_admin_gatekeeper_token

# Optional — n8n webhook URL used by /api/faculty-action to sync faculty
# actions (e.g. marks entry) to an external Google Sheets automation via n8n.
# If unset, that sync step is simply skipped.
N8N_WEBHOOK_URL=your_n8n_webhook_url

# Required — signs/verifies the httpOnly staff (faculty/admin) session cookie.
# Must be a long random string. There is no fallback: if unset, staff sessions
# cannot be created or verified and every faculty/admin request fails.
SERVER_SESSION_SECRET=your_long_random_secret

# Required — signs/verifies the student session (returned at login/activation/
# reset, stored client-side, replayed via x-student-signature). Must be a
# different long random string from SERVER_SESSION_SECRET — staff and student
# sessions must not share a key. There is no fallback: if unset, student
# sessions cannot be created or verified and every student request fails.
STUDENT_SESSION_SECRET=your_long_random_secret

# Required only to let students who activated their account BEFORE the
# STUDENT_SESSION_SECRET migration keep logging in with their existing
# password, without a forced reset. Verifies (never writes) the old
# fixed-pepper password hash format; every new activation/reset hashes with
# bcrypt instead and stops depending on this value. Safe to remove once every
# student has reset/reactivated at least once since the migration.
LEGACY_STUDENT_PASSWORD_PEPPER=the_old_pepper_value
